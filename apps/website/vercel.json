{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/:lang(es|ar)?/account", "destination": "/index.html" },
    { "source": "/:lang(es|ar)?/account/:rest*", "destination": "/index.html" },
    { "source": "/:lang(es|ar)?/book/checkout", "destination": "/index.html" },
    { "source": "/:lang(es|ar)?/sign-in", "destination": "/index.html" },
    { "source": "/:lang(es|ar)?/register", "destination": "/index.html" },
    { "source": "/:lang(es|ar)?/forgot-password", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/:lang(es|ar)?/(account|sign-in|register|forgot-password|book/checkout)(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] }
  ]
}
