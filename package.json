{
  "name": "marina",
  "private": true,
  "description": "Marina Management System: admin web app, public website and owner portal, staff mobile app, customer app and shared code",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "dev:website": "npm --prefix apps/website run dev",
    "build:website": "npm --prefix apps/website run build",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "web:mobile": "npm --prefix apps/mobile run web",
    "build:mobile-web": "npm --prefix apps/mobile run export:web",
    "dev:customer": "npm --prefix apps/customer run start",
    "web:customer": "npm --prefix apps/customer run web -- --port 8082",
    "build:customer-web": "npm --prefix apps/customer run export:web",
    "test": "npm --prefix packages/shared test",
    "lint": "npm --prefix apps/web run lint && npm --prefix apps/website run lint && npm --prefix apps/mobile run lint && npm --prefix apps/customer run lint",
    "shots": "npm --prefix tools/guide-shots run shots --",
    "site-shots": "npm --prefix tools/guide-shots run site-shots --"
  }
}
